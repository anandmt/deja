{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|clear|compact|resume",
      "hooks": [{
        "type": "command",
        "command": "bun ./dist/hooks/session-start.js",
        "timeout": 5000
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "bun ./dist/hooks/prompt-submit.js",
        "timeout": 2000
      }]
    }],
    "PostToolUse": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "bun ./dist/hooks/post-tool-use.js",
        "timeout": 5000
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "bun ./dist/hooks/session-stop.js",
        "timeout": 10000
      }]
    }]
  }
}
